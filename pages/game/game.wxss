.container{padding:44rpx 28rpx 36rpx;max-width:760rpx;margin:auto}.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:36rpx}.eyebrow{font-size:22rpx;color:#8894a8;letter-spacing:3rpx}.title{font-size:48rpx;font-weight:700;margin-top:10rpx}.badge{color:#5c76c7;background:#e8edfb;border-radius:16rpx;padding:15rpx;font-size:20rpx;letter-spacing:3rpx}.toolbar{display:flex;align-items:center;justify-content:space-between}.difficulty{background:white;border-radius:18rpx;padding:18rpx 24rpx;font-size:26rpx}.difficulty text{margin-left:22rpx;color:#7b8aac}.time{font-size:34rpx;font-weight:600;font-variant-numeric:tabular-nums}.new{margin:0;background:#4267d5;color:white;border-radius:18rpx;font-size:24rpx;padding:0 24rpx;line-height:68rpx}.stats{display:flex;justify-content:space-between;font-size:20rpx;color:#8390a7;margin:28rpx 0 18rpx}.board{display:grid;grid-template-columns:repeat(9,1fr);border:4rpx solid #415477;background:#415477;border-radius:8rpx;overflow:hidden}.cell{box-sizing:border-box;aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:white;border-right:1rpx solid #dce2ed;border-bottom:1rpx solid #dce2ed;font-size:38rpx;min-width:0}.fixed{font-weight:600;color:#26344e}.editable{color:#4267d5}.related{background:#f0f3fb}.same{background:#e0e8fc}.selected{background:#c7d6ff}.error{color:#d44960;background:#fff0f2}.box-right{border-right:4rpx solid #415477}.box-bottom{border-bottom:4rpx solid #415477}.notes{display:grid;grid-template-columns:repeat(3,1fr);width:100%;height:100%;padding:3rpx;box-sizing:border-box}.notes text{font-size:17rpx;color:#71809d;text-align:center;align-self:center}.actions{display:flex;justify-content:space-between;margin:30rpx 0}.actions button{margin:0;background:transparent;width:23%;color:#61718e;font-size:42rpx;line-height:1.4;padding:6rpx}.actions text{display:block;font-size:22rpx;margin-top:6rpx}.actions .active{background:#e4ebff;border-radius:18rpx;color:#4267d5}.keyboard{display:grid;grid-template-columns:repeat(9,1fr);gap:8rpx}.keyboard button{margin:0;padding:0;background:#e8edfa;color:#4267d5;border-radius:12rpx;width:100%;font-size:38rpx;line-height:92rpx}.tip{font-size:24rpx;color:#7d8aa0;line-height:1.8;margin:34rpx 10rpx 0;text-align:center}.saved{text-align:center;color:#a6afbf;font-size:20rpx;margin-top:22rpx}
